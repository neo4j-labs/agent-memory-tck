<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.neo4j</groupId>
    <artifactId>agent-memory-java</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Neo4j Agent Memory Java</name>

    <!-- maven-release-plugin tags and pushes through this; the client declares its own scm for Central. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/neo4j-labs/agent-memory-tck.git</connection>
        <developerConnection>scm:git:https://github.com/neo4j-labs/agent-memory-tck.git</developerConnection>
        <url>https://github.com/neo4j-labs/agent-memory-tck</url>
      <tag>java-v0.1.0</tag>
  </scm>

    <modules>
        <module>memory-client</module>
        <module>conformance</module>
    </modules>

    <properties>
        <revision>0.1.0</revision>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.skip>true</exec.skip>
    </properties>
    <build>
        <pluginManagement>
            <plugins>
                <!-- Releases are run by .github/workflows/java-release.yml; see ADR 0027. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <tagNameFormat>java-v@{project.version}</tagNameFormat>
                        <scmCommentPrefix>chore(java):</scmCommentPrefix>
                        <scmReleaseCommitComment>@{prefix} release @{releaseLabel}</scmReleaseCommitComment>
                        <scmDevelopmentCommitComment>@{prefix} prepare for next development iteration</scmDevelopmentCommitComment>
                        <releaseProfiles>release</releaseProfiles>
                        <!-- prepare already ran the tests; perform only packages and releases. -->
                        <goals>package -DskipTests</goals>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.3</version>
                    <configuration>
                        <mainClass>org.neo4j.agentmemory.conformance.ConformanceServer</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

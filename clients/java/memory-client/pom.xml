<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.neo4j</groupId>
        <artifactId>agent-memory-java</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-memory-client</artifactId>
    <name>Neo4j Agent Memory Client</name>
    <description>Java client for the hosted Neo4j Agent Memory Service.</description>
    <url>https://github.com/neo4j-labs/agent-memory-tck/tree/main/clients/java</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <organization>Neo4j Labs</organization>
            <organizationUrl>https://neo4j.com/labs/agent-memory/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/neo4j-labs/agent-memory-tck</url>
        <connection>scm:git:https://github.com/neo4j-labs/agent-memory-tck.git</connection>
        <developerConnection>scm:git:git@github.com:neo4j-labs/agent-memory-tck.git</developerConnection>
      <tag>java-v0.1.1</tag>
  </scm>

    <properties>
        <assertj.version>3.27.7</assertj.version>
        <jackson3.version>3.1.4</jackson3.version>
        <jackson2.version>2.19.0</jackson2.version>
        <langchain4j.version>1.0.0</langchain4j.version>
        <junit.version>5.14.4</junit.version>
        <logback.version>1.5.38</logback.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <spring.version>7.0.0</spring.version>
        <micrometer.version>1.16.0</micrometer.version>
        <reactor-netty.version>1.3.0</reactor-netty.version>
        <slf4j.version>2.0.20</slf4j.version>
        <swagger-request-validator.version>2.46.1</swagger-request-validator.version>
        <wiremock.version>3.13.2</wiremock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>${langchain4j.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <version>${langchain4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <version>${spring.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
            <version>${reactor-netty.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson3.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson2.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation-test</artifactId>
            <version>${micrometer.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-wiremock-junit5</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.github.tomakehurst</groupId>
                    <artifactId>wiremock-jre8</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit-pioneer</groupId>
            <artifactId>junit-pioneer</artifactId>
            <version>2.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk-platform-logging</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.netmikey.logunit</groupId>
            <artifactId>logunit-logback</artifactId>
            <version>2.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <forkCount>1</forkCount>
                    <!-- JUnit Pioneer's environment annotations require reflective access on Java 17. -->
                    <argLine>
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.lang=ALL-UNNAMED
                    </argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>without-frameworks, without-json-codecs, jackson2-only, broken-jackson3</excludedGroups>
                        </configuration>
                    </execution>

                    <execution>
                        <id>without-frameworks</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>without-frameworks</groups>

                            <excludes>
                                <exclude>**/integrations/**</exclude>
                            </excludes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>
                                    org.springframework:*
                                </classpathDependencyExclude>
                                <classpathDependencyExclude>
                                    dev.langchain4j:*
                                </classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <reportsDirectory>
                                ${project.build.directory}/surefire-reports-without-frameworks
                            </reportsDirectory>
                        </configuration>
                    </execution>

                    <execution>
                        <id>jackson2-only</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <groups>jackson2-only</groups>
                            <includes><include>**/JsonCodecSelectionTest.java</include></includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>tools.jackson.core:*</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-jackson2-only</reportsDirectory>
                        </configuration>
                    </execution>

                    <execution>
                        <id>broken-jackson3</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <groups>broken-jackson3</groups>
                            <includes><include>**/JsonCodecSelectionTest.java</include></includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>tools.jackson.core:jackson-core</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-broken-jackson3</reportsDirectory>
                        </configuration>
                    </execution>

                    <execution>
                        <id>without-json-codecs</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <groups>without-json-codecs</groups>
                            <includes><include>**/MissingJsonCodecTest.java</include></includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>tools.jackson.core:*</classpathDependencyExclude>
                                <classpathDependencyExclude>com.fasterxml.jackson.core:*</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <reportsDirectory>${project.build.directory}/surefire-reports-without-json-codecs</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doclint>all,-missing</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Activated by maven-release-plugin's release:perform on the tagged checkout. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>1.26.0</version>
                        <inherited>false</inherited>
                        <configuration>
                            <gitRootSearch>true</gitRootSearch>
                            <jreleaser>
                                <project>
                                    <name>agent-memory-client</name>
                                    <description>${project.description}</description>
                                    <authors>
                                        <author>Neo4j Labs</author>
                                    </authors>
                                    <license>Apache-2.0</license>
                                    <copyright>Neo4j</copyright>
                                </project>
                                <release>
                                    <github>
                                        <owner>neo4j-labs</owner>
                                        <name>agent-memory-tck</name>
                                        <tagName>java-v{{projectVersion}}</tagName>
                                        <releaseName>agent-memory-client {{projectVersion}}</releaseName>
                                        <skipTag>true</skipTag>
                                        <changelog>
                                            <formatted>ALWAYS</formatted>
                                            <format>- {{commitTitle}} ({{commitShortHash}})</format>
                                            <content>{{changelogChanges}}</content>
                                            <skipMergeCommits>true</skipMergeCommits>
                                            <contributors>
                                                <enabled>false</enabled>
                                            </contributors>
                                            <paths>
                                                <path>clients/java</path>
                                            </paths>
                                            <labelers>
                                                <labeler>
                                                    <label>bump</label>
                                                    <title>regex:^chore\(java\): (release|prepare) </title>
                                                </labeler>
                                            </labelers>
                                            <excludeLabels>
                                                <excludeLabel>bump</excludeLabel>
                                            </excludeLabels>
                                        </changelog>
                                    </github>
                                </release>
                                <checksum>
                                    <name>SHA256SUMS</name>
                                </checksum>
                                <files>
                                    <artifacts>
                                        <artifact>
                                            <path>${project.build.directory}/agent-memory-client-{{projectVersion}}.jar</path>
                                        </artifact>
                                        <artifact>
                                            <path>${project.build.directory}/agent-memory-client-{{projectVersion}}-sources.jar</path>
                                        </artifact>
                                        <artifact>
                                            <path>${project.build.directory}/agent-memory-client-{{projectVersion}}-javadoc.jar</path>
                                        </artifact>
                                        <artifact>
                                            <path>${project.build.directory}/.flattened-pom.xml</path>
                                            <transform>agent-memory-client-{{projectVersion}}.pom</transform>
                                        </artifact>
                                    </artifacts>
                                </files>
                            </jreleaser>
                        </configuration>
                        <executions>
                            <execution>
                                <id>release</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>release</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
